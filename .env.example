# ── Marquee configuration ───────────────────────────────────────────
# TMDB key: paste EITHER the v3 "API Key" or the v4 "API Read Access Token"
# (get one free at https://www.themoviedb.org/settings/api).
# With a key, the server seeds ~1,000 movies (posters, trailers, cast) on next start.
TMDB_API_KEY=

# Port the server listens on (all interfaces, so phones/laptops on your Wi-Fi can join).
PORT=3000

# Set to 1 to always open a public Cloudflare tunnel on start (same as `npm run share`).
SHARE=0

# Host-only "Chaos mode" in the Sync Lab (inject lag/jitter/disconnects). 1 = on.
CHAOS=1

# Max members per room.
ROOM_CAP=50

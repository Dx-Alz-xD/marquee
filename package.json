{
  "name": "marquee",
  "version": "1.0.0",
  "private": true,
  "description": "Marquee — real-time watch parties with frame-tight sync, group discovery and chaos-tested reliability.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts --dev",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "share": "npm run build && tsx server/index.ts --share",
    "seed": "tsx tools/seed-tmdb.ts",
    "seed:archive": "tsx tools/seed-archive.ts",
    "bench": "tsx tools/bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "tsx tools/e2e-features.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "cloudflared": "^0.7.3",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.56.0",
    "minisearch": "^7.2.0",
    "motion": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
